# SkillsForge Landing — Environment Variables
# Скопируй в .env и заполни реальными значениями

# ─────────────────────────────────────────────
# STRIPE — Payments
# ─────────────────────────────────────────────

# Secret key (тестовый: sk_test_..., боевой: sk_live_...)
# Получить: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_placeholder_replace_me

# Webhook signing secret — из Stripe Dashboard > Webhooks
# Endpoint URL: https://your-domain.com/api/webhook
# События: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me

# Price IDs из Stripe Dashboard > Products
# Создай 3 продукта:
#   Starter: one-time $49 → price_xxx (mode: payment)
#   Pro:     recurring $14/mo → price_xxx (mode: subscription)
#   Team:    recurring $199/yr → price_xxx (mode: subscription)
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_PRO=price_placeholder_pro
STRIPE_PRICE_TEAM=price_placeholder_team

# ─────────────────────────────────────────────
# RESEND — Email delivery
# ─────────────────────────────────────────────

# API ключ: https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_replace_me

# From-адрес (должен быть верифицирован в Resend)
RESEND_FROM_EMAIL=hello@skillsforge.dev

# Audience ID для mailing list (Resend Dashboard → Audiences → Create)
# Все free-skill сигнапы + покупки автоматически добавляются в этот audience
# для drip-кампаний. Source автоматически tagged (free-skill / starter-purchase / pro-purchase / team-purchase)
RESEND_AUDIENCE_ID=aud_placeholder_replace_me

# ─────────────────────────────────────────────
# DELIVERY — Ссылка на ZIP архив скиллов
# ─────────────────────────────────────────────

# URL на ZIP с skills (GitHub Release или pre-signed S3/R2 URL)
# Пример GitHub Release: https://github.com/your-org/skillsforge-pack/releases/latest/download/pack.zip
GITHUB_RELEASE_ZIP_URL=https://github.com/your-org/skillsforge-pack/releases/latest/download/skillsforge-seo-geo-pack.zip

# ─────────────────────────────────────────────
# COMMUNITY
# ─────────────────────────────────────────────

# Discord invite link (для Pro и Team tier email)
DISCORD_INVITE_URL=https://discord.gg/placeholder

# ─────────────────────────────────────────────
# PATHS (опционально)
# ─────────────────────────────────────────────

# Абсолютный путь к папке со скиллами на сервере
# По умолчанию: ../skills (относительно landing/)
# На Vercel — используй абсолютный путь или встрой skills в build
# SKILLS_DIR=/app/skills

# Email основателя — BCC на каждое подтверждение free skill,
# чтобы фаундер видел поток waitlist-сигнапов в личной почте,
# не открывая отдельный admin-дашборд (MVP вариант, до Supabase)
FOUNDER_EMAIL=founder@skillsforge.dev

# ─────────────────────────────────────────────
# ASTRO
# ─────────────────────────────────────────────

# Публичный URL сайта (для canonical и OG)
SITE=https://skillsforge.dev

# Используется в /api/checkout для построения success_url / cancel_url.
# НЕ берём из заголовка Origin (caller-controlled).
PUBLIC_SITE_URL=https://skillsforge.dev
