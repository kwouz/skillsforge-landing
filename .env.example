# SkillsForge Landing — Environment Variables
# Скопируй в .env и заполни реальными значениями

# ─────────────────────────────────────────────
# GUMROAD — Payments (Merchant of Record)
# ─────────────────────────────────────────────
#
# Gumroad handles checkout, fulfillment (auto-emails the ZIP after purchase),
# subscription billing, refunds and VAT/sales-tax. No webhook or download
# endpoint is needed on our side — we just redirect buyers to the product URL.
#
# Setup: create 3 products in Gumroad, upload dist/skillsforge-seo-pack-v1.0.0.zip
# as the file, then paste each public product URL below.
#   Starter:  one-time $49 (Lifetime)
#   Pro:      subscription $14/month
#   Team:     one-time $199 (5-seat license, 1 year)
#
# URLs must be https:// and on a *.gumroad.com host (validated in /api/checkout).

GUMROAD_URL_STARTER=https://gumroad.com/l/placeholder-starter
GUMROAD_URL_PRO=https://gumroad.com/l/placeholder-pro
GUMROAD_URL_TEAM=https://gumroad.com/l/placeholder-team

# ─────────────────────────────────────────────
# RESEND — Email delivery (used only by /api/free-skill email-gate)
# ─────────────────────────────────────────────

# API ключ: https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_replace_me

# From-адрес (должен быть верифицирован в Resend; домен pitchinsixty.com уже верифицирован)
RESEND_FROM_EMAIL=hello@pitchinsixty.com

# Audience ID для mailing list (Resend Dashboard → Audiences → Create)
# Free-skill сигнапы автоматически добавляются в этот audience
# для drip-кампаний. Source автоматически tagged как `free-skill`.
RESEND_AUDIENCE_ID=aud_placeholder_replace_me

# ─────────────────────────────────────────────
# COMMUNITY
# ─────────────────────────────────────────────

# Discord invite link (показывается в Gumroad receipt и email после Pro/Team purchase)
DISCORD_INVITE_URL=https://discord.gg/placeholder

# ─────────────────────────────────────────────
# PATHS (опционально)
# ─────────────────────────────────────────────

# Абсолютный путь к папке со скиллами на сервере
# По умолчанию: ../skills (относительно landing/)
# На Vercel — используй абсолютный путь или встрой skills в build
# SKILLS_DIR=/app/skills

# Email основателя — BCC на каждое подтверждение free skill,
# чтобы фаундер видел поток waitlist-сигнапов в личной почте,
# не открывая отдельный admin-дашборд (MVP вариант, до Supabase)
FOUNDER_EMAIL=founder@skillsforge.dev

# ─────────────────────────────────────────────
# ASTRO
# ─────────────────────────────────────────────

# Публичный URL сайта (для canonical и OG)
SITE=https://skillsforge.dev

# Используется в success.astro для canonical link.
PUBLIC_SITE_URL=https://skillsforge.dev
