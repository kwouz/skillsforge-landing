---
import Icon from './Icon.astro';

interface Skill {
  slug: string;
  name: string;
  description: string;
  isFree?: boolean;
}

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

const iconMap: Record<string, { name: string; color: string }> = {
  'seo-pseo-generator': { name: 'pseo', color: '#7c5cff' },
  'geo-aeo-optimizer': { name: 'crosshair', color: '#3ddc97' },
  'schema-markup-engineer': { name: 'schema', color: '#a78bfa' },
  'content-brief-builder': { name: 'brief', color: '#7c5cff' },
  'technical-seo-auditor': { name: 'scan', color: '#3ddc97' },
  'keyword-cluster-mapper': { name: 'cluster', color: '#a78bfa' },
  'internal-linking-architect': { name: 'link', color: '#7c5cff' },
  'ai-mentions-monitor': { name: 'radio', color: '#3ddc97' },
  'backlink-outreach-engine': { name: 'mail', color: '#a78bfa' },
  'gbp-local-seo': { name: 'pin', color: '#7c5cff' },
  'free-teaser-seo-meta': { name: 'gift', color: '#3ddc97' },
};
---

<section id="skills" class="py-20 px-4 sm:px-6" style="border-top: 1px solid rgba(255,255,255,0.06);">
  <div class="max-w-6xl mx-auto">
    <!-- Заголовок -->
    <div class="text-center mb-14">
      <p class="text-sm font-medium mb-3" style="color: #a78bfa; letter-spacing: 0.08em; text-transform: uppercase;">
        What you get
      </p>
      <h2
        class="text-3xl sm:text-4xl font-bold mb-4"
        style="color: #e8e8ed; letter-spacing: -0.02em;"
      >
        11 skills. Every core SEO/GEO workflow.
      </h2>
      <p class="text-base max-w-xl mx-auto" style="color: #8888a0;">
        Drop any skill into your Claude Code project. Works standalone or as a pipeline step.
      </p>
    </div>

    <!-- Карточки -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {skills.map((skill) => {
        const icon = iconMap[skill.slug] ?? { name: 'wrench', color: '#7c5cff' };
        return (
          <div
            class="card-hover relative p-6 rounded-xl"
            style={`background: #111118; border: 1px solid ${skill.isFree ? 'rgba(61,220,151,0.2)' : 'rgba(255,255,255,0.06)'}; cursor: default;`}
          >
            {skill.isFree && (
              <span
                class="absolute top-4 right-4 text-xs font-medium px-2 py-0.5 rounded-full"
                style="background: rgba(61,220,151,0.12); color: #3ddc97; border: 1px solid rgba(61,220,151,0.25);"
              >
                FREE
              </span>
            )}
            <div
              class="mb-4 inline-flex items-center justify-center"
              style={`width: 44px; height: 44px; border-radius: 10px; background: ${icon.color}1f; border: 1px solid ${icon.color}33;`}
            >
              <Icon name={icon.name} color={icon.color} size={24} />
            </div>
            <h3
              class="text-base font-semibold mb-2"
              style="color: #e8e8ed; letter-spacing: -0.01em;"
            >
              {skill.name.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}
            </h3>
            <p class="text-sm leading-relaxed" style="color: #8888a0;">
              {/* Берём первое предложение описания для краткости */}
              {skill.description.split('.')[0]}.
            </p>
          </div>
        );
      })}
    </div>

    <!-- Нижний CTA -->
    <div class="text-center mt-12">
      <a
        href="#pricing"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm transition-all"
        style="background: rgba(124,92,255,0.12); color: #a78bfa; border: 1px solid rgba(124,92,255,0.25); text-decoration: none;"
        onmouseover="this.style.background='rgba(124,92,255,0.2)'"
        onmouseout="this.style.background='rgba(124,92,255,0.12)'"
      >
        Get all 11 skills for $49
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
