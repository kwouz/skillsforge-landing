---
interface Props {
  name: string;
  size?: number;
  color?: string;
  strokeWidth?: number;
  class?: string;
}

const {
  name,
  size = 28,
  color = '#a78bfa',
  strokeWidth = 1.75,
  class: className = '',
} = Astro.props;

// Custom Lucide-derived SVG paths. Each icon hand-picked to match a skill.
const ICONS: Record<string, string> = {
  // SkillsGrid
  'pseo': `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M10 6.5h4M10 17.5h4M6.5 10v4M17.5 10v4"/>`,
  'crosshair': `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>`,
  'schema': `<path d="M12 3 4 7v10l8 4 8-4V7l-8-4z"/><path d="M4 7l8 4 8-4M12 11v10"/><path d="M8 5l8 4M16 5l-8 4" opacity="0.45"/>`,
  'brief': `<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3M8 10h8M8 14h8M8 18h5"/>`,
  'scan': `<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3.5"/><path d="m15 15 4 4"/>`,
  'cluster': `<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><circle cx="12" cy="12" r="2.5"/><path d="m7.7 7.7 2.6 2.6M16.3 7.7l-2.6 2.6M7.7 16.3l2.6-2.6M16.3 16.3l-2.6-2.6"/>`,
  'link': `<path d="M9 17H6a5 5 0 0 1 0-10h3M15 7h3a5 5 0 0 1 0 10h-3M8 12h8"/>`,
  'radio': `<circle cx="12" cy="12" r="2.5"/><path d="M5.5 18.5a9 9 0 0 1 0-13M18.5 5.5a9 9 0 0 1 0 13M8.5 15.5a5 5 0 0 1 0-7M15.5 8.5a5 5 0 0 1 0 7"/>`,
  'mail': `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/><path d="m14 14 7 5M10 14l-7 5" opacity="0.45"/>`,
  'pin': `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>`,
  'gift': `<rect x="3" y="9" width="18" height="12" rx="1.5"/><path d="M3 13h18M12 9v12"/><path d="M12 9c-1.5-3-3-4-5-3-1.5.8-1 3 1 3h4zM12 9c1.5-3 3-4 5-3 1.5.8 1 3-1 3h-4z"/>`,
  'wrench': `<path d="M14.7 6.3a4 4 0 1 1 3 3l-9 9a2.5 2.5 0 1 1-3-3l9-9z"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>`,
  // ProblemSection
  'spark': `<path d="M12 2v6M12 16v6M2 12h6M16 12h6M5 5l4 4M15 15l4 4M19 5l-4 4M9 15l-4 4"/>`,
  'clock': `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2.5"/>`,
  'settings': `<circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.6-2-3.5-2.4 1a7 7 0 0 0-2-1.2L14 3h-4l-.5 2.5a7 7 0 0 0-2 1.2l-2.4-1-2 3.5 2 1.6a7 7 0 0 0 0 2.4l-2 1.6 2 3.5 2.4-1a7 7 0 0 0 2 1.2L10 21h4l.5-2.5a7 7 0 0 0 2-1.2l2.4 1 2-3.5-2-1.6c.07-.4.1-.8.1-1.2z"/>`,
};

const path = ICONS[name];
---

{path && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke={color}
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    set:html={path}
  />
)}
